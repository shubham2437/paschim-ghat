# Public site URL (used for absolute links / metadata)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Fallback WhatsApp business number for the "Order on WhatsApp" BFF route,
# used only if the catalogue workbook's Settings!whatsapp cell is empty.
# Server-side only — never exposed to the client bundle.
WHATSAPP_BUSINESS_NUMBER=911800200743

# Support phone number shown in the UI.
NEXT_PUBLIC_SUPPORT_PHONE=1800-200-7433

# ---------------------------------------------------------------------------
# Catalogue Google Sheet — the storefront's only data source (no local file
# is checked into the repo). Two ways to connect it, use ONE:
# ---------------------------------------------------------------------------

# RECOMMENDED — service account (locked-down / private Sheet).
# Keep the Sheet's sharing set to Restricted and share it only with the
# service account's email as Viewer. See README "Security: locking down
# the Sheet" for the full Google Cloud setup steps.
CATALOGUE_SHEET_ID=1qDeyeS7CZQf5mcuTACDfIE1g0B4RCiN6oZJOGfE8tlo
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
# Paste the private_key value from the downloaded JSON key as one line,
# keeping its literal \n sequences (do not convert them to real newlines).
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvQ...\n-----END PRIVATE KEY-----\n"

# ALTERNATIVE — public link (simpler, but anyone with this URL can read the
# data). Only used if the service account vars above are not set. Sheet
# must be shared "Anyone with the link" as Viewer.
# CATALOGUE_SHEET_URL=https://docs.google.com/spreadsheets/d/YOUR_SHEET_ID/export?format=xlsx

# Set whichever variables you use in your hosting platform's environment
# variables too, not just .env.local (which is git-ignored and never
# reaches a deployment).

# ---------------------------------------------------------------------------
# Cloudflare Turnstile (bot check on the order + checkout forms).
# Create a widget at Cloudflare dashboard → Turnstile → Add widget, then set
# both values as runtime variables in Workers → Settings → Variables and
# Secrets (the secret as type "Secret"). No rebuild is needed.
# Until TURNSTILE_SECRET_KEY is set, the widget is hidden and the check is
# skipped, so ordering keeps working.
# For local dev you can use Cloudflare's always-pass test keys:
#   site key 1x00000000000000000000AA / secret 1x0000000000000000000000000000000AA
# ---------------------------------------------------------------------------
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Search-engine verification (meta-tag method). Paste only the `content` value.
BING_SITE_VERIFICATION=
GOOGLE_SITE_VERIFICATION=
